NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/skillvault
JWT_SECRET=change_this_to_at_least_32_characters_secret_key_12345
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=change_this_to_at_least_32_characters_encryption_key
FRONTEND_URL=http://localhost:3000
TRUST_PROXY_HOPS=1
COOKIE_SAMESITE=lax

# Optional: Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Default Manual Payment Receiving Numbers (Admin > Settings can also set these)
BKASH_NUMBER=01XXXXXXXXX
NAGAD_NUMBER=01XXXXXXXXX
ROCKET_NUMBER=01XXXXXXXXX

# Optional: SMTP Email Configuration
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="SkillVault <noreply@example.com>"

# Optional: Server-Side Tracking Fallbacks (can also be configured via Admin > Settings)
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4_MEASUREMENT_SECRET=
# META_PIXEL_ID=
# META_ACCESS_TOKEN=
# TIKTOK_PIXEL_ID=
# TIKTOK_ACCESS_TOKEN=

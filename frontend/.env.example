# Public site URL (used for SEO, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave empty to use the built-in /api proxy (recommended). Set only for direct cross-site API calls.
NEXT_PUBLIC_API_URL=
# Server-side only: where the Express API lives (used by rewrites and server components)
BACKEND_URL=http://localhost:5000
